{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "formatter": {
        "enabled": true,
        "useEditorconfig": true
    },
    "assist": {
        "actions": null
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!var",
            "!vendor",
            "!public",
            "!node_modules",
            "!assets/libs"
        ]
    }
}
